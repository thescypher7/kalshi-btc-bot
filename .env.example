# Template for /etc/kalshi-bot/logger.env on the VPS (owner root:kalshi, mode 640).
# Never commit the real file or the private key.
KALSHI_KEY_ID=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY_PATH=/etc/kalshi-bot/kalshi_private_key.pem
LOG_DB=/var/lib/kalshi-bot/kalshi_log.sqlite

# Optional overrides (defaults are in logger/kalshi_logger.py)
# KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
# KALSHI_REST_BASE=https://api.elections.kalshi.com
# KALSHI_SERIES=KXBTC15M
